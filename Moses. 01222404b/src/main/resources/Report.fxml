<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="500.0"
            prefWidth="900.0"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.template.ui.ReportController"
            style="-fx-background-color: #f0f2f5;">

    <!-- ===== TOP TOOLBAR WITH TITLE + BUTTONS ===== -->
    <top>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 20; -fx-background-color: #ffffff; -fx-border-color: #dcdcdc; -fx-border-width: 0 0 1 0;">

            <!-- Title -->
            <Label text="Student Academic Report"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #34495e;" />

            <Region HBox.hgrow="ALWAYS" />

            <!-- Buttons -->
            <Button text="Import CSV File"
                    onAction="#importCsv"
                    style="-fx-background-color: #2980b9;  /* new color */
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 6 16;
                           -fx-cursor: hand;" />

            <Button text="Export CSV File"
                    onAction="#exportCsv"
                    style="-fx-background-color: #27ae60;  /* new color */
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 6 16;
                           -fx-cursor: hand;" />

        </HBox>
    </top>

    <!-- ===== MAIN TABLE AREA ===== -->
    <center>
        <VBox style="-fx-padding: 20;">
            <TableView fx:id="reportTable"
                       VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 10;
                              -fx-border-color: #dcdcdc;
                              -fx-border-radius: 10;">
                <columns>
                    <TableColumn fx:id="reportIdColumn" text="Student ID" prefWidth="120"/>
                    <TableColumn fx:id="reportNameColumn" text="Full Name" prefWidth="170"/>
                    <TableColumn fx:id="reportProgrammeColumn" text="Programme" prefWidth="150"/>
                    <TableColumn fx:id="reportLevelColumn" text="Academic Level" prefWidth="120"/>
                    <TableColumn fx:id="reportGpaColumn" text="GPA Score" prefWidth="100"/>
                    <TableColumn fx:id="reportStatusColumn" text="Academic Status" prefWidth="150"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <!-- ===== BOTTOM FOOTER ===== -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 10 20 10 20; -fx-background-color: #ffffff; -fx-border-color: #dcdcdc; -fx-border-width: 1 0 0 0;">
            <Label text="© 2026 Academic Reporting System" style="-fx-text-fill: #7f8c8d; -fx-font-size: 12px;" />
        </HBox>
    </bottom>

</BorderPane>